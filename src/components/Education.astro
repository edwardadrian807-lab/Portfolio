---
import Section from "./Section.astro";

interface Props {
  education: {
    institution: string;
    degree: string;
    startDate: string;
    endDate: string;
    score: string;
  }[];
}

const { education } = Astro.props;
---

<Section text="Education" href="education">
  <div class="space-y-8">
    {education.map((item) => (
      <div
        class="group rounded-xl border border-neutral/20 p-6
               transition-all duration-300
               hover:-translate-y-1
               hover:border-purple-400
               hover:shadow-[0_0_25px_rgba(168,85,247,0.6)]"
      >
        <h3
          class="text-xl font-semibold text-neutral
                 transition-all duration-300
                 group-hover:text-purple-300"
        >
          {item.degree}
        </h3>

        <p class="mt-1 text-neutral/80">
          {item.institution}
        </p>

        <div class="mt-2 flex flex-wrap gap-4 text-sm text-neutral/60">
          <span>
            {item.startDate} – {item.endDate}
          </span>

          <span>
            {item.score}
          </span>
        </div>
      </div>
    ))}
  </div>
</Section>
